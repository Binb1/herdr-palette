# VHS tape for the README demo. Run: vhs demo.tape
Output demo.gif

Set FontSize 20
Set Width 1030
Set Height 630
Set Padding 18
Set Margin 44
Set MarginFill "#26262A"
Set BorderRadius 8
Set Theme { "background": "#151517", "foreground": "#CDD6F4", "black": "#45475A", "red": "#E35D6A", "green": "#5BB974", "yellow": "#E8A33D", "blue": "#89B4FA", "magenta": "#CBA6F7", "cyan": "#94E2D5", "white": "#CDD6F4", "brightBlack": "#6C7086", "brightRed": "#E35D6A", "brightGreen": "#5BB974", "brightYellow": "#F8BC82", "brightBlue": "#89B4FA", "brightMagenta": "#CBA6F7", "brightCyan": "#94E2D5", "brightWhite": "#CDD6F4", "cursor": "#F8BC82" }

Hide
Type "./bin/herdr-palette"
Enter
Sleep 1.5s
Show

Sleep 2s
Type@180ms "fod"
Sleep 1.5s
Backspace@120ms 3
Sleep 800ms
Type@250ms ">"
Sleep 1.2s
Down@450ms 3
Sleep 1.5s
Escape
Sleep 600ms
